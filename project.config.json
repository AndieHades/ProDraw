{
  "title": "ProDraw",
  "packageName": "prodraw",
  "product": "touch-first raster graphics editor",
  "targetPlatform": "windows-desktop",
  "developmentRuntime": "vite-web",
  "languages": ["ru", "en"],
  "lineLimit": 150,
  "docsLineLimit": 250,
  "maxCanvasSide": 8192,
  "maxCanvasPixels": 50000000,
  "legacyCodeOverLimit": [
    "src/app.js",
    "src/i18n/locales/en.js",
    "src/i18n/locales/ru.js",
    "src/systems/color-picker.js",
    "src/systems/crop.js",
    "src/systems/palette-select.js",
    "src/systems/reference-window.js",
    "src/systems/shading.js",
    "src/systems/tile-from-layer.js",
    "src/systems/tilemap-dialog.js",
    "src/systems/tilemap-paint/index.js",
    "src/systems/toolbars.js"
  ],
  "legacyDocsOverLimit": [
    "docs/animation.md",
    "docs/tileset-tilemap.md"
  ]
}
