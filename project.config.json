{
  "title": "ProDraw",
  "packageName": "prodraw",
  "product": "touch-first raster graphics editor",
  "targetPlatform": "windows-desktop",
  "developmentRuntime": "vite-web",
  "languages": ["ru", "en"],
  "lineLimit": 150,
  "docsLineLimit": 250,
  "maxCanvasSide": 8192,
  "maxCanvasPixels": 50000000,
  "cutover": {
    "stage": "C5",
    "runtimeMode": "shell",
    "productionEntry": "src/legacy-entry.js",
    "targetEntry": "src/raster-main.ts",
    "maximumSourceJavaScriptFiles": 254,
    "maximumLegacyStateJavaScriptFiles": 169
  },
  "legacyCodeOverLimit": [
    "test/module-int.mjs",
    "test/unit.mjs"
  ],
  "legacyDocsOverLimit": ["docs/animation.md"]
}
