{
  "name": "prodraw",
  "version": "0.1.0",
  "description": "Windows-first raster graphics editor for pen and touch",
  "author": "Andie Hades",
  "private": true,
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "main": "desktop/electron-main.mjs",
  "scripts": {
    "dev": "vite",
    "build": "npm run check && vite build",
    "build:bundle": "vite build",
    "build:desktop": "npm run check && vite build --mode desktop",
    "check": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/prodraw.tsbuildinfo",
    "package:desktop": "node tools/package-desktop.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "npm run test:legacy && npm run test:ts && npm run test:performance",
    "test:legacy": "node test/no-cyrillic.mjs && node test/unit.mjs && node test/storage.mjs",
    "test:ts": "vitest run --exclude tests/performance/** --exclude tests/brush/**",
    "test:performance": "vitest run tests/performance --maxWorkers=1 --no-file-parallelism",
    "smoke:desktop": "npm run package:desktop",
    "validate": "node tools/validate.mjs",
    "validate:architecture": "node tools/validate-architecture-fixtures.mjs",
    "validate:cutover": "node tools/validate-cutover.mjs",
    "validate:cutover-fixtures": "node tools/validate-cutover-fixtures.mjs",
    "validate:cycles": "node tools/check-import-cycles.mjs",
    "validate:desktop": "node tools/validate-desktop-shell.mjs",
    "validate:docs": "node tools/validate-docs.mjs",
    "validate:hooks": "node tools/validate-hooks.mjs",
    "validate:interface": "node tools/validate-interface-parity.mjs",
    "validate:lines": "node tools/check-line-limit.mjs",
    "validate:raster-entry": "node tools/validate-raster-entry.mjs",
    "validate:shell-catalog": "node tools/validate-shell-catalog.mjs",
    "validate:changed": "node tools/validate-changed.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.0.0",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.5.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.0.12",
    "vitest": "^4.1.9"
  },
  "build": {
    "appId": "com.andiehades.prodraw",
    "productName": "ProDraw",
    "directories": {
      "output": "artifacts/desktop"
    },
    "files": [
      "dist/**",
      "desktop/**",
      "package.json"
    ]
  },
  "dependencies": {
    "ag-psd": "^31.0.2"
  }
}
